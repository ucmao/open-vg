# Frontend Environment Variables
# Copy this file to .env and adjust values for your environment

# ============================================
# Development Environment - Default Configuration
# ============================================
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
NUXT_INTERNAL_API_URL=http://127.0.0.1:8000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_WS_URL=ws://localhost:8000
PORT=3000

# Rewards Page Ad Space (Optional, hidden if not configured)
# JSON array, each item: { "imageUrl": "Image URL", "url": "Click Link URL" }
# Single item shows statically, multiple items auto-carousel; 'url' can be omitted for display-only
# NUXT_PUBLIC_REWARDS_ADS=[{"imageUrl":"https://example.com/ad1.jpg","url":"https://example.com/1"},{"imageUrl":"https://example.com/ad2.jpg","url":"https://example.com/2"}]

# Generate Page Ad Space (Optional, hidden if not configured)
# JSON array, each item: { "imageUrl": "Image URL", "url": "Click Link URL" }
# Single item shows statically, multiple items auto-carousel; 'url' can be omitted for display-only
# NUXT_PUBLIC_GENERATE_ADS=[{"imageUrl":"https://example.com/ad1.jpg","url":"https://example.com/1"}]

# ============================================
# Production Environment
# ============================================
# Use the following configuration when deploying to production:

# Client API Base URL (Must be an empty string!)
# ⚠️ IMPORTANT: API calls in the code already include the '/api' prefix (e.g., api.get('/api/works'))
# If set to '/api', actual requests will become '/api/api/works' (404 error)
# NUXT_PUBLIC_API_BASE_URL=

# SSR Internal API URL (Required!)
# Nuxt server-side rendering requires this URL to directly access the backend
# Missing configuration will cause "Network error occurred" on page refresh
# NUXT_INTERNAL_API_URL=http://127.0.0.1:8000

# Public Site URL (Used for SSR fallback and SEO)
# NUXT_PUBLIC_SITE_URL=https://yourdomain.com

# Public CDN URL (Optional, for Cloudflare R2 / S3 public media access)
# NUXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# WebSocket URL (Must use full URL, HTTPS requires wss://)
# NUXT_PUBLIC_WS_URL=wss://yourdomain.com

# Service Port (Nuxt server listening port)
# PORT=3000

# ============================================
# Configuration Notes
# ============================================

# 1. NUXT_PUBLIC_API_BASE_URL
#    - Development: http://localhost:8000 (forwarded via Nuxt devProxy)
#    - Production: Must be empty string!
#      Reason: Code API calls already include '/api' prefix
#      Example: api.get('/api/works') → Browser requests /api/works → Nginx forwards to backend
#
# 2. NUXT_INTERNAL_API_URL
#    - Development: http://127.0.0.1:8000 (optional)
#    - Production: Must be configured! http://127.0.0.1:8000
#      Reason: Nuxt server directly calls backend API during SSR
#      Missing configuration causes page refresh failure
#
# 3. NUXT_PUBLIC_SITE_URL
#    - Development: http://localhost:3000 (optional)
#    - Production: https://vidgenerator.ai (your actual domain)
#      Purpose: SSR fallback, SEO, constructing absolute URLs
#
# 4. NUXT_PUBLIC_WS_URL
#    - Development: ws://localhost:8000
#    - Production: wss://vidgenerator.ai (origin only; the client appends the API path)
#      Note: HTTPS sites must use wss:// (WebSocket Secure)
#
# 5. PORT
#    - Development: 3000 (default)
#    - Production: 3000 (or your configured port)
#      Purpose: Nuxt server listening port
#
# 6. Rewards Page Ad Space (Optional)
#    - NUXT_PUBLIC_REWARDS_ADS: JSON array, e.g. [{"imageUrl":"...","url":"..."}]
#
# 7. Generate Page Ad Space (Optional)
#    - NUXT_PUBLIC_GENERATE_ADS: JSON array, e.g. [{"imageUrl":"...","url":"..."}]

# ============================================
# Production Complete Configuration Example
# ============================================
# NUXT_PUBLIC_API_BASE_URL=
# NUXT_INTERNAL_API_URL=http://127.0.0.1:8000
# NUXT_PUBLIC_SITE_URL=https://vidgenerator.ai
# NUXT_PUBLIC_WS_URL=wss://vidgenerator.ai
# PORT=3000

# ============================================
# Troubleshooting
# ============================================
#
# ❌ Issue: "Network error occurred" on page refresh
# ✅ Solution: Ensure NUXT_INTERNAL_API_URL is configured
#
# ❌ Issue: API request returns 404 with URL showing /api/api/...
# ✅ Solution: Change NUXT_PUBLIC_API_BASE_URL to an empty string (not '/api')
#
# ❌ Issue: Browser Network panel shows request to localhost:8000
# ✅ Solution: Rebuild frontend (rm -rf .nuxt .output && npm run build)
#
# ❌ Issue: WebSocket connection failed
# ✅ Solution: Ensure NUXT_PUBLIC_WS_URL uses a full origin (wss://yourdomain.com)

# ============================================
# Payment Options Configuration
# ============================================
# Stripe Publishable Key
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Company Contact Information (Optional, fallback defaults provided)
# NUXT_PUBLIC_COMPANY_NAME="VIDGEN TECHNOLOGY LIMITED"
# NUXT_PUBLIC_COMPANY_ADDRESS="100 Enterprise Boulevard, Suite 500, Innovation District"
# NUXT_PUBLIC_COMPANY_EMAIL="support@example.com"

# Social Media Links (Optional, defaults to '#')
# NUXT_PUBLIC_SOCIAL_PINTEREST="https://www.pinterest.com/youraccount"
# NUXT_PUBLIC_SOCIAL_FACEBOOK="https://www.facebook.com/youraccount"
# NUXT_PUBLIC_SOCIAL_YOUTUBE="https://www.youtube.com/@youraccount"
# NUXT_PUBLIC_SOCIAL_LINKEDIN="https://www.linkedin.com/company/youraccount"
# NUXT_PUBLIC_SOCIAL_GITHUB="https://github.com/youraccount"
# NUXT_PUBLIC_SOCIAL_DISCORD="https://discord.gg/yourinvite"


