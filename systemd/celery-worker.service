# ============================================================================
# Celery Worker Systemd Service
# ============================================================================
# : /etc/systemd/system/celery-worker.service
# :  Celery Worker ，
# ============================================================================

[Unit]
Description=Celery Worker for Vidgen
Documentation=https://docs.celeryq.dev/
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
Type=simple
User=www-data
Group=www-data

# （）
WorkingDirectory=/path/to/vidgen/backend

Environment="PATH=/path/to/vidgen/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"

#  .env （）
# EnvironmentFile=/path/to/vidgen/backend/.env

# Start
ExecStart=/path/to/vidgen/backend/venv/bin/celery -A app.celery_app worker \
    --loglevel=info \
    --concurrency=4 \
    --hostname=worker1@%%h \
    --max-tasks-per-child=100 \
    --logfile=/var/log/celery/worker.log

# Stop（Stop）
ExecStop=/bin/kill -TERM $MAINPID

# Restart
Restart=always
RestartSec=10

# Stop（）
TimeoutStopSec=600
KillMode=mixed
KillSignal=SIGTERM

# （）
LimitNOFILE=65536
# MemoryLimit=2G
# CPUQuota=200%

# （，）
# PrivateTmp=true
# NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
