# ============================================================================
# AIGC Platform - Environment Configuration Example
# ============================================================================
# Copy this file to .env and fill in the actual values.
# Do NOT commit the .env file to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Environment Mode Configuration
# ----------------------------------------------------------------------------
# Environment mode: 'development' or 'production'
# In development mode, verification codes are returned directly in API responses for testing
# In production mode, verification codes are sent via email only
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# 1.1 Security Keys & Encryption (CRITICAL FOR PRODUCTION)
# ----------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (Must be strong and random in production!)
JWT_SECRET=your_jwt_secret_key_at_least_16_chars_long
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# Secret key used to encrypt vendor API Keys stored in the database
CONFIG_ENCRYPTION_KEY=your_random_config_encryption_key_here

# Secret token used for authenticating requests to the overseas video parser service
OVERSEAS_PARSER_TOKEN=your_random_overseas_parser_token_here

# ----------------------------------------------------------------------------
# 1.2 Initial Super Admin Account
# ----------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_admin_password_in_production

# ----------------------------------------------------------------------------
# 2. Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL database connection URL
# Format: postgresql://username:password@host:port/dbname
# Example: postgresql://user:password@localhost:5432/aigc_platform
DATABASE_URL=postgresql://user:password@localhost:5432/aigc_platform

# ----------------------------------------------------------------------------
# 2.1 Redis Configuration (Recommended for production: cache/verification/Celery queues)
# ----------------------------------------------------------------------------
# Redis connection URL
# Local example: redis://localhost:6379/0
# With password example: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379
# Optional: Redis key prefix (for multi-environment / multi-project isolation)
REDIS_PREFIX=vidgen:

# Celery task queue configuration (using Redis)
# Default uses Redis DB 2 as broker, DB 3 as result backend
# If custom configuration is needed:
# CELERY_BROKER_URL=redis://localhost:6379/2
# CELERY_RESULT_BACKEND=redis://localhost:6379/3

# ----------------------------------------------------------------------------
# 3. API Base URL Configuration
# ----------------------------------------------------------------------------
# Backend API base URL (used for webhooks and internal API calls)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
BACKEND_URL=http://localhost:8000

# Frontend application URL (used for OAuth callbacks and payment redirects)
# Development: http://localhost:3000
# Production: https://yourdomain.com
# Note: Production must use HTTPS
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# 4. PayPal Payment Configuration
# ----------------------------------------------------------------------------
# PayPal Client ID and Secret (from PayPal Developer Dashboard)
# Sandbox: https://developer.paypal.com/dashboard/applications/sandbox
# Production: https://developer.paypal.com/dashboard/applications/live (switch to Live mode)
# 
# Steps to obtain credentials:
# 1. Visit PayPal Developer Dashboard
# 2. Create an application (sandbox or live)
# 3. Copy Client ID and Secret
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_secret_here

# PayPal Mode: 'sandbox' (test environment) or 'live' (production environment)
# IMPORTANT: Never use 'live' credentials for 'sandbox' mode, or vice versa
PAYPAL_MODE=sandbox

# ----------------------------------------------------------------------------
# 5. Google OAuth Configuration
# ----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (for user authentication)
# Obtain from: https://console.cloud.google.com/apis/credentials
#
# Steps:
# 1. Visit Google Cloud Console
# 2. Create OAuth 2.0 Client ID
# 3. Add authorized redirect URIs:
#    Development: http://localhost:3000/auth/google/callback
#    Production: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google OAuth Redirect URI (Optional override)
# Format: {FRONTEND_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=

# ----------------------------------------------------------------------------
# 6. AI Generation Service API Keys
# ----------------------------------------------------------------------------
# Replicate API Key (for AI model generation)
# Obtain from: https://replicate.com/account/api-tokens
# Purpose: Text-to-Image, Image-to-Image, Video Generation
REPLICATE_API_KEY=your_replicate_api_key_here

# A2E API Key (used for AI model generation)
# Get from: https://video.a2e.ai/
# Use: As a replacement for Replicate, for some models
A2E_API_TOKEN=your_a2e_api_token_here
A2E_API_BASE_URL=https://video.a2e.ai

# ----------------------------------------------------------------------------
# 7. Email Service (SMTP) Configuration
# ----------------------------------------------------------------------------
# SMTP Server Configuration (for sending emails)
# Gmail Example (Requires App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587 (STARTTLS) or 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP Authentication Credentials
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email Sender Information
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AIGC Platform

# Note: Using Gmail requires:
# 1. Enabling 2-Step Verification
# 2. Generating App Password: https://myaccount.google.com/apppasswords
# 3. Using App Password (not normal password) as SMTP_PASSWORD

# ----------------------------------------------------------------------------
# 8. Cloudflare R2 Storage Configuration
# ----------------------------------------------------------------------------
# Cloudflare R2 Object Storage (for media files)
# Obtain Credentials: https://dash.cloudflare.com/
#
# Steps:
# 1. Create R2 bucket in Cloudflare dashboard
# 2. Go to Manage R2 API Tokens
# 3. Create API token with read/write permissions
# 4. Get endpoint, access key, and secret key
#
# If unconfigured, system falls back to local file storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key_here
R2_SECRET_KEY=your_r2_secret_key_here
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_DOMAIN=

# Optional: R2 file public domain (if using custom domain)
# R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# ----------------------------------------------------------------------------
# 8.1 Mock AI Generation Mode (For Local Testing & Open-Source Contributors)
# ----------------------------------------------------------------------------
# Set to 'true' to enable Mock AI Generation mode (no paid API calls needed!).
# Simulates AI video/image generation with placeholder assets for UI testing.
MOCK_AI_GENERATION=false

# ============================================================================
# Notes
# ============================================================================
# - Keep all API keys and passwords secure
# - Do NOT commit the .env file to version control
# - Use environment variables in production (Docker, Kubernetes, etc.)
# - Test all integrations in sandbox/development mode first
# - Backup important credentials
# ============================================================================

# Stripe Payment Configuration
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd

# ----------------------------------------------------------------------------
# 9. User Incentive System Configuration
# ----------------------------------------------------------------------------
# New User Registration Reward
NEW_USER_CREDITS=10                    # Credits awarded to new users upon registration
NEW_USER_CREDITS_EXPIRY_DAYS=30        # Credit validity period for new users (days)

# Daily Check-in Rewards
CHECKIN_BASE_REWARD=5                  # Base check-in reward credits
CHECKIN_CONSECUTIVE_BONUS=2            # Consecutive check-in bonus credits (increases daily)
CHECKIN_MAX_CONSECUTIVE=7              # Consecutive check-in reward cap (days)
CHECKIN_REWARD_EXPIRY_DAYS=60          # Check-in credit validity period (days)

# Referral Rewards
INVITE_REWARD_INVITER=10               # Credits awarded to inviter
INVITE_REWARD_INVITEE=10               # Credits awarded to invitee
INVITE_CODE_LENGTH=8                   # Invite code length
INVITE_REWARD_EXPIRY_DAYS=90           # Referral reward credit validity period (days)